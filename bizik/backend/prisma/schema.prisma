// =============================================================================
// BiZik - Complete Database Schema
// Escrow & Cross-Border Payment Platform (SRS-BIZIK-2026-v1.0)
// -----------------------------------------------------------------------------
// Modeled from the SRS (§6.1 Core Data Entities) and the Modularization &
// Dev-Phases document (per-service table inventory).
//
// ARCHITECTURE NOTE
// BiZik is a DDD microservices system where each service owns an isolated
// PostgreSQL database (auth_db, kyc_db, user_db, contract_db, escrow_db,
// wallet_db, dispute_db, notification_db, compliance/reporting). This single
// Prisma schema is the *unified logical model* of every table across those
// services - useful for a monolith-first build, prototyping, and as the
// canonical data dictionary. When split into services later, each section
// below maps to one service database.
//
// Because services do not share databases in production, cross-context links
// are modeled as INDEXED SOFT REFERENCES (a scalar `*Id` column, no foreign
// key) rather than Prisma relations. Real Prisma relations are used only
// WITHIN a single bounded context, where a true FK is valid.
//
// Conventions: money = Decimal(20,4), FX rates = Decimal(20,8), tables are
// snake_case plural (@@map), surrogate keys are uuid() except Contract which
// uses the human-readable QTQ id from the SRS.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS (shared vocabulary)
// =============================================================================

enum UserRole {
  FREELANCER
  CLIENT
  AGENCY
  ADMIN
  COMPLIANCE
  MEDIATOR
}

enum UserStatus {
  PENDING // created, phone not yet verified (verification flips it to ACTIVE)
  ACTIVE
  SUSPENDED
  FROZEN // AML / sanctions hold - reversible only by Compliance
  CLOSED
}

enum Currency {
  USD
  EUR
  GBP
  NGN
  GHS
  XAF
}

enum TwoFactorMethodType {
  TOTP
  SMS
  EMAIL
}

enum OAuthProvider {
  GOOGLE
  LINKEDIN
}

// ---- KYC ----
enum KycStatus {
  NOT_STARTED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum KycIdType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  VOTERS_CARD
}

enum KycDocumentType {
  ID_FRONT
  ID_BACK
  SELFIE
  ADDRESS_PROOF
  BUSINESS_CERTIFICATE
  DIRECTOR_ID
}

enum ScreeningResult {
  CLEAR
  MATCH
  PEP
}

// ---- Contract ----
enum ContractStatus {
  DRAFT
  INVITED
  UNDER_REVIEW
  SIGNED
  FUNDED
  IN_PROGRESS
  IN_REVIEW
  DISPUTED
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING // defined, not yet funded
  FUNDED // money held in escrow
  ACTIVE // work in progress
  SUBMITTED // delivered, awaiting client approval
  APPROVED // approved, release queued
  RELEASED // paid out
  DISPUTED
  CANCELLED // cancelled by the creator while still unfunded - kept for history
}

enum InvitationStatus {
  SENT
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SignatureRole {
  FREELANCER
  CLIENT
}

enum AmendmentStatus {
  PROPOSED
  ACCEPTED
  REJECTED
}

// ---- Escrow / Payment ----
enum EscrowAccountStatus {
  OPEN
  PARTIALLY_RELEASED
  RELEASED
  REFUNDED
  FROZEN
  CLOSED
}

enum EscrowTxType {
  FUND
  HOLD
  RELEASE
  REFUND
  ADJUSTMENT // manual admin ledger correction
}

enum TxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum PaymentGateway {
  STRIPE
  PAYSTACK
  FLUTTERWAVE
  MTN_MOMO
  ORANGE_MONEY
  PAYONEER
  WISE
  PAYPAL
  BANK_TRANSFER
  ACH
  INTERNAL
}

enum PaymentIntentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum RefundStatus {
  INITIATED
  PROCESSING
  COMPLETED
  FAILED
}

enum FeeType {
  CLIENT_SERVICE_FEE // 3.5% at funding
  FREELANCER_FEE // 2.5% on release
  EXPRESS_WITHDRAWAL // +1.5%
  FX_MARGIN // 0.5% over mid-market
  DISPUTE_FEE
}

// ---- Wallet ----
enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum WalletTxType {
  DEPOSIT // release credited from escrow
  WITHDRAWAL
  ESCROW_HOLD // moved from wallet into escrow when funding a milestone
  FEE
  REFUND
  FX_IN
  FX_OUT
  TRANSFER_IN // received from another BiZik user
  TRANSFER_OUT // sent to another BiZik user
  ADJUSTMENT
}

enum PayoutMethodType {
  MTN_MOMO
  ORANGE_MONEY
  PAYONEER
  BANK
}

enum PayoutStatus {
  INITIATED
  PROCESSING
  ON_HOLD // held by compliance/ops pending review
  COMPLETED
  FAILED
}

// ---- Dispute ----
enum DisputeStatus {
  FILED
  AWAITING_RESPONSE
  UNDER_REVIEW
  ESCALATED
  RESOLVED
  AUTO_RULED
}

enum DisputeReason {
  NON_DELIVERY
  INCOMPLETE_WORK
  QUALITY_BELOW_SPEC
  SCOPE_CREEP
  COMMUNICATION_BREAKDOWN
  OTHER
}

enum DisputeRulingType {
  FULL_RELEASE
  FULL_REFUND
  PARTIAL_SPLIT
}

// ---- Notifications ----
enum NotificationCategory {
  PAYMENT
  CONTRACT
  KYC
  DISPUTE
  SECURITY
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// ---- Reputation ----
enum BadgeType {
  VERIFIED // KYC complete
  PRO // 10+ contracts, 4.5+, 0% dispute
  ELITE // 50+ contracts, 4.8+
}

// ---- Compliance / Admin ----
enum AmlAlertType {
  STRUCTURING
  SANCTIONS_MATCH
  HIGH_RISK_FLOW
  VELOCITY_ANOMALY
  PEP_MATCH
}

enum AmlAlertStatus {
  NEW
  UNDER_REVIEW
  CLEARED
  ESCALATED
}

enum ReportType {
  DAILY_TRANSACTION_SUMMARY
  MONTHLY_AML
  KYC_COVERAGE
  SUSPICIOUS_ACTIVITY
  EARNINGS_TAX
  GMV_ANALYTICS
}

enum ReportFormat {
  PDF
  CSV
  XLSX
}

enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
}

// =============================================================================
// SERVICE: auth-service  (auth_db)
// users, sessions, refresh_tokens, 2fa_methods, login_attempts,
// password_reset_tokens, oauth_accounts
// =============================================================================

model User {
  id                String     @id @default(uuid(7))
  /// Public handle (e.g. "maxime.bichenyi") used to send money to this person
  /// without knowing their phone number. Generated from their name at signup
  /// and unique across the platform; the user may change it to another free one.
  username          String?    @unique
  // Phone is the identity/login key for end users (unique, required in the app
  // layer). Kept nullable at the DB level so existing/staff rows that predate
  // phone-first signup don't block a migration; new signups always set it.
  phone             String?    @unique
  // Email is now OPTIONAL for end users (added for KYC / under personal info).
  // Staff/operator accounts still use email to sign in.
  email             String?    @unique
  passwordHash      String?
  fullName          String
  // Unified account: everyone starts as a base CLIENT. Freelancer capability
  // is unlocked via verification (see `freelancerEnabled`), not a signup fork.
  role              UserRole   @default(CLIENT)
  country           String? // optional - collected at freelancer verification
  status            UserStatus @default(PENDING)
  kycTier           Int        @default(0) // 0..3 (SRS FR-KYC-001)
  /// True once the user has verified (phone + country + KYC) to create contracts.
  freelancerEnabled Boolean    @default(false)
  emailVerified     Boolean    @default(false)
  phoneVerified     Boolean    @default(false)
  twoFactorEnabled  Boolean    @default(false)
  companyName       String? // clients / agencies
  locale            String     @default("en") // en | fr
  /// Platform-operator role (RBAC). Non-null = has admin-console access.
  adminRoleId       String?
  /// When the account holder accepted the Terms of Service + Privacy Policy
  /// (signup checkbox in the app, explicit "I agree" tap on WhatsApp).
  termsAcceptedAt   DateTime?

  /// Where this account was created from, captured at signup: the client
  /// ("web" | "mobile" | "whatsapp"), the address it came from and the agent
  /// string. Without it, "is this real traffic or a bot?" can only be answered
  /// by joining session rows, and not at all once sessions expire.
  signupSource    String?
  signupIp        String?
  signupUserAgent String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?

  sessions       Session[]
  refreshTokens  RefreshToken[]
  twoFactor      TwoFactorMethod[]
  backupCodes    BackupCode[]
  passwordResets PasswordResetToken[]
  oauthAccounts  OAuthAccount[]
  loginAttempts  LoginAttempt[]
  adminRole      AdminRole?           @relation("UserAdminRole", fields: [adminRoleId], references: [id])

  @@index([role])
  @@index([status])
  @@index([country])
  @@index([adminRoleId])
  @@map("users")
}

/// Dynamic platform-operator role (RBAC). `permissions` are code-defined keys
/// (see lib/permissions.ts); the super-admin role (`isSuperAdmin`) grants all.
/// Only super admins can create/edit roles and assign them to operators.
model AdminRole {
  id           String   @id @default(uuid(7))
  name         String   @unique
  description  String?
  permissions  String[] @default([])
  isSuperAdmin Boolean  @default(false)
  isSystem     Boolean  @default(false) // built-in; cannot be deleted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  operators User[] @relation("UserAdminRole")

  @@map("admin_roles")
}

model Session {
  id        String    @id @default(uuid(7))
  userId    String
  userAgent String?
  ipAddress String?
  device    String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id            String    @id @default(uuid(7))
  userId        String
  tokenHash     String    @unique
  rotatedFromId String?
  /// The sign-in this token belongs to. Rotation keeps it, so revoking one
  /// session kills exactly that device's tokens and leaves the others alone.
  sessionId     String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

model TwoFactorMethod {
  id        String              @id @default(uuid(7))
  userId    String
  method    TwoFactorMethodType
  secret    String? // TOTP shared secret - AES-256-GCM via lib/crypto, not plaintext
  isPrimary Boolean             @default(false)
  verified  Boolean             @default(false)
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, method])
  @@map("2fa_methods")
}

model BackupCode {
  id        String    @id @default(uuid(7))
  userId    String
  codeHash  String
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("backup_codes")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7))
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model OAuthAccount {
  id                String        @id @default(uuid(7))
  userId            String
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model LoginAttempt {
  id         String   @id @default(uuid(7))
  userId     String?
  email      String
  ipAddress  String?
  successful Boolean
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([userId])
  @@map("login_attempts")
}

// =============================================================================
// SERVICE: kyc-service  (kyc_db + S3)
// kyc_records, kyc_documents, manual_review_queue, sanctions_screenings
// =============================================================================

model KycRecord {
  /// True when the scores on this record came from the built-in stand-in rather
  /// than a real identity provider - i.e. nobody actually checked the documents.
  providerSimulated Boolean @default(true)
  /// What the image analysis actually observed, as a list of pass/fail findings
  /// with reasons. Shown to the reviewer so a score is never just a number.
  providerChecks    Json?
  /// Triage suggestion from that analysis (approve / reject / review + why).
  /// Advisory: it speeds a reviewer up, it never decides for them.
  providerAdvice    Json?

  id              String     @id @default(uuid(7))
  userId          String // soft ref -> users
  tier            Int // target tier 1..3
  idType          KycIdType?
  idNumber        String? // encrypted
  selfieScore     Decimal?   @db.Decimal(4, 3)
  matchScore      Decimal?   @db.Decimal(4, 3)
  documentScore   Decimal?   @db.Decimal(4, 3)
  status          KycStatus  @default(SUBMITTED)
  provider        String? // smile_identity | stripe_identity
  providerRef     String?
  rejectionReason String?
  reviewedById    String? // soft ref -> users (admin)
  reviewedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  documents   KycDocument[]
  reviewItems ManualReviewItem[]

  @@index([userId])
  @@index([status])
  @@map("kyc_records")
}

model KycDocument {
  id          String          @id @default(uuid(7))
  kycRecordId String
  type        KycDocumentType
  fileId      String // soft ref -> files
  createdAt   DateTime        @default(now())

  kycRecord KycRecord @relation(fields: [kycRecordId], references: [id], onDelete: Cascade)

  @@index([kycRecordId])
  @@map("kyc_documents")
}

model ManualReviewItem {
  id           String    @id @default(uuid(7))
  kycRecordId  String
  reason       String // e.g. low confidence < 0.85
  assignedToId String? // soft ref -> users (admin)
  resolved     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  kycRecord KycRecord @relation(fields: [kycRecordId], references: [id], onDelete: Cascade)

  @@index([kycRecordId])
  @@map("manual_review_queue")
}

model SanctionsScreening {
  id         String          @id @default(uuid(7))
  userId     String // soft ref -> users
  provider   String          @default("complyadvantage")
  result     ScreeningResult
  matchData  Json?
  screenedAt DateTime        @default(now())

  @@index([userId])
  @@map("sanctions_screenings")
}

// =============================================================================
// SERVICE: user-service  (user_db + Elasticsearch)
// profiles, skills, profile_skills, portfolio_items, reviews, badges,
// score_history
// =============================================================================

model Profile {
  id                 String   @id @default(uuid(7))
  userId             String   @unique // soft ref -> users
  username           String   @unique
  displayName        String
  bio                String? // 500 chars
  country            String
  avatarColor        String?
  bizikScore         Int      @default(0) // 0..100
  completedContracts Int      @default(0)
  disputeRate        Decimal  @default(0) @db.Decimal(5, 2)
  avgRating          Decimal  @default(0) @db.Decimal(3, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  skills       ProfileSkill[]
  portfolio    PortfolioItem[]
  badges       Badge[]
  scoreHistory ScoreHistory[]

  @@map("profiles")
}

model Skill {
  id       String         @id @default(uuid(7))
  name     String         @unique // drawn from taxonomy
  category String?
  profiles ProfileSkill[]

  @@map("skills")
}

model ProfileSkill {
  profileId String
  skillId   String

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@map("profile_skills")
}

model PortfolioItem {
  id        String   @id @default(uuid(7))
  profileId String
  title     String
  url       String?
  fileId    String? // soft ref -> files
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("portfolio_items")
}

model Badge {
  id        String    @id @default(uuid(7))
  profileId String
  type      BadgeType
  awardedAt DateTime  @default(now())
  revokedAt DateTime?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, type])
  @@map("badges")
}

model Review {
  id         String    @id @default(uuid(7))
  contractId String // soft ref -> contracts
  reviewerId String // soft ref -> users
  revieweeId String // soft ref -> users
  rating     Int // 1..5
  comment    String? // 300 chars
  visibleAt  DateTime? // double-blind release
  reported   Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@unique([contractId, reviewerId])
  @@index([revieweeId])
  @@map("reviews")
}

model ScoreHistory {
  id        String   @id @default(uuid(7))
  profileId String
  score     Int
  reason    String?
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("score_history")
}

// =============================================================================
// SERVICE: contract-service  (contract_db)
// contracts, milestones, deliverables, milestone_submissions,
// revision_requests, contract_signatures, amendments, amendment_signatures,
// contract_templates, template_milestones, contract_invitations
// =============================================================================

model Contract {
  id          String  @id // QTQ-YYYYMMDD-XXXXXX
  title       String
  description String?
  category    String?

  // Symmetric parties - no global client/freelancer role. The creator invites a
  // counterparty (by email); either side may be the payer (chosen per project).
  creatorId         String // soft ref -> users (who created the project)
  counterpartyId    String? // soft ref -> users (set once the email/phone matches an account)
  // The name the CREATOR knows the counterparty by - an alias, private to this
  // deal. Optional: if omitted we fall back to the counterparty's own master
  // account name once they've joined. NOT the counterparty's account name.
  counterpartyName  String?
  counterpartyEmail String? // invite by email and/or phone
  counterpartyPhone String? // invite via WhatsApp number
  /// true if the CREATOR funds escrow (pays); false if the counterparty pays.
  creatorIsPayer    Boolean @default(false)

  currency       Currency
  totalAmount    Decimal        @db.Decimal(20, 4)
  status         ContractStatus @default(INVITED)
  inspectionDays Int            @default(5) // 3..14
  templateId     String? // soft ref -> contract_templates

  /// Counterparty confirmation (they accept the project).
  accepted   Boolean   @default(false)
  acceptedAt DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  signedByClientAt     DateTime?
  signedByFreelancerAt DateTime?
  fundedAt             DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?

  milestones  Milestone[]
  signatures  ContractSignature[]
  amendments  ContractAmendment[]
  invitations ContractInvitation[]

  @@index([creatorId])
  @@index([counterpartyId])
  @@index([counterpartyEmail])
  @@index([counterpartyPhone])
  @@index([status])
  @@map("contracts")
}

model Milestone {
  id                String          @id @default(uuid(7))
  contractId        String
  order             Int
  title             String
  description       String?
  amount            Decimal         @db.Decimal(20, 4)
  currency          Currency
  deadline          DateTime?
  inspectionDays    Int             @default(5)
  status            MilestoneStatus @default(PENDING)
  revisionCount     Int             @default(0)
  maxRevisions      Int             @default(3)
  submittedAt       DateTime?
  approvedAt        DateTime?
  releasedAt        DateTime?
  autoReleaseAt     DateTime? // inspection-period timeout
  dueReminderSentAt DateTime? // set once we've reminded both parties the day before `deadline`

  contract     Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  deliverables Deliverable[]
  submissions  MilestoneSubmission[]
  revisions    RevisionRequest[]

  @@index([contractId])
  @@index([status])
  @@map("milestones")
}

model Deliverable {
  id          String  @id @default(uuid(7))
  milestoneId String
  description String
  fileId      String? // soft ref -> files

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@map("deliverables")
}

model MilestoneSubmission {
  id            String   @id @default(uuid(7))
  milestoneId   String
  submittedById String // soft ref -> users
  note          String?
  fileIds       String[] // soft refs -> files
  createdAt     DateTime @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@map("milestone_submissions")
}

model RevisionRequest {
  id            String   @id @default(uuid(7))
  milestoneId   String
  requestedById String // soft ref -> users (client)
  feedback      String
  createdAt     DateTime @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@map("revision_requests")
}

model ContractSignature {
  id         String        @id @default(uuid(7))
  contractId String
  userId     String // soft ref -> users
  role       SignatureRole
  ipAddress  String?
  signedAt   DateTime      @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, role])
  @@map("contract_signatures")
}

model ContractAmendment {
  id           String          @id @default(uuid(7))
  contractId   String
  version      Int
  proposedById String // soft ref -> users
  changes      Json
  status       AmendmentStatus @default(PROPOSED)
  createdAt    DateTime        @default(now())
  resolvedAt   DateTime?

  contract   Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  signatures AmendmentSignature[]

  @@index([contractId])
  @@map("amendments")
}

model AmendmentSignature {
  id          String        @id @default(uuid(7))
  amendmentId String
  userId      String // soft ref -> users
  role        SignatureRole
  signedAt    DateTime      @default(now())

  amendment ContractAmendment @relation(fields: [amendmentId], references: [id], onDelete: Cascade)

  @@unique([amendmentId, role])
  @@map("amendment_signatures")
}

model ContractTemplate {
  id        String   @id @default(uuid(7))
  ownerId   String? // soft ref -> users; null = system template
  name      String
  category  String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  milestones TemplateMilestone[]

  @@index([ownerId])
  @@map("contract_templates")
}

model TemplateMilestone {
  id          String  @id @default(uuid(7))
  templateId  String
  order       Int
  title       String
  description String?
  amountPct   Decimal @db.Decimal(5, 2) // % of contract total

  template ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("template_milestones")
}

model ContractInvitation {
  id         String           @id @default(uuid(7))
  contractId String
  email      String
  token      String           @unique
  status     InvitationStatus @default(SENT)
  expiresAt  DateTime
  createdAt  DateTime         @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_invitations")
}

// =============================================================================
// SERVICE: escrow-service / payment-service  (escrow_db - strict ACID)
// escrow_accounts, escrow_transactions, payment_intents, gateway_webhooks,
// refunds, fee_records
// =============================================================================

model EscrowAccount {
  id             String              @id @default(uuid(7))
  contractId     String              @unique // soft ref -> contracts
