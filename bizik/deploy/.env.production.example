# =============================================================================
# Bizik — production environment (/opt/bizik/.env.production on the VPS)
# Copy to `.env.production`, fill every value, `chmod 600`. NEVER commit real
# secrets. Generate strong secrets with:  openssl rand -hex 48
# =============================================================================

# ---- Deploy / images (used by docker-compose.prod.yml) ----------------------
REGISTRY=ghcr.io/lyftsoft-technologies
IMAGE_TAG=latest

# ---- Database (native Postgres via host PgBouncer) --------------------------
# Runtime pool (transaction mode). `pgbouncer=true` disables prepared statements.
DATABASE_URL=postgresql://bizik:CHANGE_ME_DB_PASSWORD@host.docker.internal:6432/bizik?pgbouncer=true&connection_limit=25
# Schema sync / migrations (session mode = behaves like a direct connection).
DIRECT_DATABASE_URL=postgresql://bizik:CHANGE_ME_DB_PASSWORD@host.docker.internal:6432/bizik_session

# ---- Cache / queues ---------------------------------------------------------
REDIS_URL=redis://redis:6379

# ---- URLs & CORS ------------------------------------------------------------
APP_URL=https://api.bizik.cm
WEB_URL=https://bizik.cm
CORS_ORIGINS=https://bizik.cm,https://www.bizik.cm,https://admin.bizik.cm
PUBLIC_WHATSAPP_URL=https://wa.me/2376XXXXXXXX?text=Hi%20Bizik

# ---- Secrets (REQUIRED — 48+ random bytes each) -----------------------------
ENFORCE_PROD_SECRETS=true
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
KYC_ENC_KEY=CHANGE_ME

# ---- WhatsApp Cloud API -----------------------------------------------------
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_REQUIRE_PIN=true

# ---- AI (WhatsApp assistant) ------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=

# ---- Email (SMTP) -----------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
FROM_NAME=Bizik
FROM_EMAIL=no-reply@bizik.cm

# ---- SMS (Twilio) -----------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ---- Payments (Fapshi live) -------------------------------------------------
PAYMENTS_MODE=live
PAYMENT_DEFAULT_CURRENCY=XAF
PAYMENT_CALLBACK_BASE_URL=https://api.bizik.cm
FAPSHI_ENVIRONMENT=live
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_WEBHOOK_SECRET=
# Payouts use a SEPARATE Fapshi service with its own credentials: a Fapshi
# service is either collection or disbursement, never both. Create the
# disbursement service in the dashboard, test it in sandbox, then ask Fapshi
# support to enable payouts for that live API user. While these are empty,
# withdrawals are still accepted but wait in the operator payout queue.
FAPSHI_PAYOUT_API_USER=
FAPSHI_PAYOUT_API_KEY=
# --- TEMPORARY: phone verification bypass -----------------------------------
# Phone numbers are the identity on this platform (deals are invited by number,
# transfers route to one, password reset goes there), so verification is ON
# unless this says exactly "false". It exists for periods when SMS delivery is
# blocked outside the code - e.g. a Twilio trial account, which rejects every
# number it has not verified. Remove the line to turn verification back on.
PHONE_VERIFICATION_REQUIRED=true
PHONE_VERIFICATION_RESUME_ON=

# --- SMS delivery ------------------------------------------------------------
# Which rail to try first: orange | twilio | auto (default). `auto` sends
# Cameroon (+237) numbers via Orange and everything else via Twilio, each
# falling back to the other if it fails.
SMS_PROVIDER=auto

# Orange SMS API (Cameroon). Credentials come from your application's page on
# developer.orange.com. Sending draws down a prepaid bundle, so messages stop
# when it empties or expires - the server logs the balance at boot.
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
# Country short code; Cameroon is tel:+2370000.
ORANGE_SMS_SENDER_ADDRESS=tel:+2370000
# Leave EMPTY unless Orange has whitelisted a custom sender name for this
# account - an unapproved name is rejected with 400.
ORANGE_SMS_SENDER_NAME=
# Only with an "Orange only" bundle, which cannot reach other operators.
ORANGE_SMS_ONNET=false
# Warn at boot when fewer than this many messages remain.
ORANGE_SMS_LOW_BALANCE=25



# ---- Cloudinary (delivery / evidence images) --------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
