# Copy to .env and fill in. .env is gitignored and must stay that way:
# this repository is public.

# ---- Meta Model API -------------------------------------------------------
# OpenAI-compatible. The key goes as a bearer token. Anthropic-style clients
# use the bare host (https://api.meta.ai) instead of the /v1 path.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Model ids, PINNED. The docs list muse-spark-1.3, 1.2 and 1.1, and at least
# one client defaults to 1.1 - so an unpinned id can silently change what the
# demo is running. Verify each against dev.meta.ai/docs/quickstart before the
# first real call; the voice and SAM ids are not confirmed yet.
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_WONDER_MODEL=muse-wonder-1.0
MUSE_VOICE_MODEL=
SAM_MODEL=

# ---- Open-weight path -----------------------------------------------------
# For the evaluation harness and the open-weights bonus prize. The
# `meta-models/` prefix is part of the id on Baseten and must not be dropped.
OPEN_WEIGHTS_BASE_URL=
OPEN_WEIGHTS_API_KEY=
OPEN_WEIGHTS_MODEL=meta-models/muse-spark-open-1026

# ---- Escalation policy ----------------------------------------------------
# Below this confidence, a case goes to a human instead of showing a
# recommendation. Deliberately cautious.
ESCALATE_BELOW_CONFIDENCE=0.75
# Above this disputed amount (XAF), always escalate regardless of confidence.
ESCALATE_ABOVE_AMOUNT_XAF=250000

# ---- Bizik callback -------------------------------------------------------
# Writes a suggestion row only. There is deliberately no endpoint here that
# could resolve a dispute or move money.
BIZIK_API_BASE_URL=
BIZIK_SERVICE_TOKEN=

PORT=4100
